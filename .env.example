# FRED API key – get one free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Anthropic API key – powers the dashboard's Interpretation tab (on demand, cached).
# Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional OpenAI API key – used only by the experimental agent stubs (experimental/agents/)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Kaggle credentials for backfill loader
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
